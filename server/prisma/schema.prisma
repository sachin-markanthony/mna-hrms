generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}
enum Role {
  SUPER_ADMIN
  HR_ADMIN
  HR_COORDINATOR
  TEAM_LEADER
  EMPLOYEE
}

enum EmploymentStatus {
  ACTIVE
  ON_NOTICE
  INACTIVE
  ARCHIVED
}

// Shared Identity & Auth (Single Source of Truth across CRM & HRMS)
model User {
  id               String           @id @default(uuid())
  employeeId       String           @unique
  email            String           @unique
  username         String?          @unique
  passwordHash     String
  name             String
  phone            String?
  role             Role             @default(EMPLOYEE)
  employmentStatus EmploymentStatus @default(ACTIVE)
  canImpersonate   Boolean          @default(false)
  isArchived       Boolean          @default(false)
  qrCodeUrl        String?
  dateOfJoining    DateTime?
  refreshTokenHash String?
  lastLoginAt      DateTime?

  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)

  roleId         String?
  roleDefinition RoleDefinition? @relation(fields: [roleId], references: [id], onDelete: SetNull)

  employee               Employee?
  actorAudits            SystemAuditLog[]   @relation("AuditActor")
  targetAudits           SystemAuditLog[]   @relation("AuditTarget")
  leaveBalances          LeaveBalance[]
  leaveRequests          LeaveRequest[]     @relation("LeaveApplicant")
  teamLeadLeaveApprovals LeaveRequest[]     @relation("LeaveTeamLeadApprover")
  hrLeaveApprovals       LeaveRequest[]     @relation("LeaveHrApprover")
  attendanceMaster       AttendanceMaster[]
  attendanceRawLogs      AttendanceRawLog[]
  siteVisits             SiteVisit[]
  regularizations        AttendanceRegularization[] @relation("RegularizationApplicant")
  reviewedRegularizations AttendanceRegularization[] @relation("RegularizationReviewer")
  inductionProgress      InductionProgress[]
  inductionNotifications InductionNotification[]
  assignedCandidates     Candidate[]              @relation("CandidateTeamLeader")
  generatedPayrollRuns   PayrollRun[]             @relation("PayrollGenerator")
  lockedPayrollRuns      PayrollRun[]             @relation("PayrollLocker")
  paidPayrollRuns        PayrollRun[]             @relation("PayrollPayer")
  payslips               Payslip[]
  createdLetters         OfficialLetter[]         @relation("LetterCreator")
  offboardingRequests    OffboardingRequest[]     @relation("OffboardingUser")
  initiatedOffboardings  OffboardingRequest[]     @relation("OffboardingInitiator")
  portalNotifications    PortalNotification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}
// Dynamic RBAC: Manageable Roles & Granular Permissions
model RoleDefinition {
  id          String           @id @default(uuid())
  name        String           @unique
  displayName String
  description String?
  isSystem    Boolean          @default(false)
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  key         String           @unique
  module      String
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           String         @id @default(uuid())
  roleId       String
  role         RoleDefinition @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission     @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime       @default(now())

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model Team {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("teams")
}

// Departments
model Department {
  id           String        @id @default(uuid())
  name         String        @unique
  description  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  employees    Employee[]
  designations Designation[]

  @@map("departments")
}

enum DocumentType {
  AADHAAR
  PAN
  DEGREE
  OFFER_LETTER
  NDA
  OTHER
}

model Employee {
  id                    String             @id @default(uuid())
  userId                String             @unique
  departmentId          String?
  jobTitle              String?
  hireDate              DateTime?
  salary                Float?
  gender                String?
  dateOfBirth           DateTime?          @db.Date
  bloodGroup            String?
  address               String?
  emergencyContactName  String?
  emergencyContactPhone String?
  bankAccountNumber     String?
  bankIfsc              String?
  bankName              String?
  panNumber             String?
  aadhaarNumber         String?
  uanNumber             String?
  reportingManagerId    String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  department            Department?        @relation(fields: [departmentId], references: [id])
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents             EmployeeDocument[]
  officialLetters       OfficialLetter[]
  offboardingRequests   OffboardingRequest[]

  @@map("employees")
}

model EmployeeDocument {
  id           String       @id @default(uuid())
  employeeId   String
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  docType      DocumentType
  fileName     String
  fileUrl      String
  isVerified   Boolean      @default(false)
  verifiedById String?
  verifiedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([employeeId])
  @@map("employee_documents")
}
// Tier 2: Enterprise Security & Impersonation Audit Logs (Strictly Append-Only)
model SystemAuditLog {
  id              String   @id @default(uuid())
  actorUserId     String
  actorUser       User     @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  targetUserId    String?
  targetUser      User?    @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  actionType      String
  ipAddress       String?
  userAgent       String?
  oldValuePayload Json?
  newValuePayload Json?
  createdAt       DateTime @default(now())

  @@index([actorUserId])
  @@index([targetUserId])
  @@index([actionType])
  @@map("system_audit_logs")
}

enum LeaveType {
  CASUAL
  SICK
  EARNED
  LOP
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalDecision {
  PENDING
  APPROVED
  REJECTED
}

enum AttendanceStatus {
  PRESENT
  HALF_DAY
  ABSENT
  ON_LEAVE
  LOP
}

// Leave Balance Ledger (Casual, Sick, Earned, LOP)
model LeaveBalance {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaveType     LeaveType
  year          Int
  allocatedDays Float     @default(0)
  usedDays      Float     @default(0)
  remainingDays Float     @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([userId, leaveType, year])
  @@index([userId, year])
  @@map("leave_balances")
}

// Leave Requests (Two-stage approval: Team Lead AND HR must both approve)
model LeaveRequest {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation("LeaveApplicant", fields: [userId], references: [id], onDelete: Cascade)
  leaveType LeaveType
  startDate DateTime    @db.Date
  endDate   DateTime    @db.Date
  totalDays Float
  reason    String
  status    LeaveStatus @default(PENDING)

  // Stage 1: Team Lead Approval
  teamLeadStatus       ApprovalDecision @default(PENDING)
  teamLeadApprovedById String?
  teamLeadApprovedBy   User?            @relation("LeaveTeamLeadApprover", fields: [teamLeadApprovedById], references: [id], onDelete: SetNull)
  teamLeadApprovedAt   DateTime?
  teamLeadRemarks      String?

  // Stage 2: HR Approval
  hrStatus       ApprovalDecision @default(PENDING)
  hrApprovedById String?
  hrApprovedBy   User?            @relation("LeaveHrApprover", fields: [hrApprovedById], references: [id], onDelete: SetNull)
  hrApprovedAt   DateTime?
  hrRemarks      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([startDate, endDate])
  @@map("leave_requests")
}

// Attendance Master (Reconciled daily records; synced on final leave approval)
model AttendanceMaster {
  id             String           @id @default(uuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  attendanceDate DateTime         @db.Date
  firstPunchIn   DateTime?
  lastPunchOut   DateTime?
  officeHours    Float            @default(0)
  siteVisitHours Float            @default(0)
  totalWorkHours Float            @default(0)
  status         AttendanceStatus @default(ABSENT)
  isLate         Boolean          @default(false)
  remarks        String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([userId, attendanceDate])
  @@index([attendanceDate])
  @@map("attendance_master")
}

enum ChapterStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  LOCKED
}

model InductionSession {
  id                String             @id @default(uuid())
  sessionNumber     Int                @unique
  title             String
  subtitle          String?
  description       String
  chapterStart      Int
  chapterEnd        Int
  estimatedDuration String
  orderIndex        Int                @default(0)
  chapters          InductionChapter[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@map("induction_sessions")
}

model InductionChapter {
  id                String              @id @default(uuid())
  chapterNumber     Int                 @unique
  title             String
  description       String
  estimatedDuration String
  sessionId         String
  session           InductionSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  isAssessment      Boolean             @default(false)
  isResource        Boolean             @default(false)
  orderIndex        Int                 @default(0)
  progress          InductionProgress[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@map("induction_chapters")
}

model InductionProgress {
  id                 String           @id @default(uuid())
  userId             String
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapterId          String
  chapter            InductionChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  status             ChapterStatus    @default(NOT_STARTED)
  progressPercentage Int              @default(0)
  lastAccessedAt     DateTime         @default(now())
  completedAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([userId, chapterId])
  @@map("induction_progress")
}

model InductionNotification {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  message     String
  type        String   @default("info")
  actionLabel String?
  actionRoute String?
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("induction_notifications")
}


enum RecruitmentDepartment {
  DIGITAL
  SALES
}

enum CandidateRecruitmentStatus {
  REGISTERED
  HR_ROUND
  MR_ROUND
  SELECTED
  REJECTED_HR
  REJECTED_MR
}

enum InterviewRoundType {
  HR_ROUND
  MR_ROUND
}

enum RoundEvaluationResult {
  PASSED
  REJECTED
}

model Candidate {
  id              String                     @id @default(uuid())
  fullName        String
  email           String
  phone           String
  department      RecruitmentDepartment
  appliedRole     String
  visitDate       DateTime                   @default(now())
  status          CandidateRecruitmentStatus @default(REGISTERED)
  experienceYears Float                      @default(0)
  currentCompany  String?
  expectedSalary  String?
  tags            String[]                   @default([])
  hrInterviewer   String?
  hrRating        Float?
  hrFeedback      String?
  hrEvaluatedAt   DateTime?
  mrInterviewer   String?
  mrRating        Float?
  mrFeedback      String?
  mrEvaluatedAt   DateTime?
  rejectionReason    String?
  confidentialNotes  String?
  hrVerifiedBy       String?
  hrVerifiedAt       DateTime?
  hrCoordinatorId    String?
  registrationSource String                     @default("HR_PORTAL")
  teamLeaderId       String?
  teamLeaderName     String?
  teamLeader      User?                      @relation("CandidateTeamLeader", fields: [teamLeaderId], references: [id], onDelete: SetNull)
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  evaluations     RoundEvaluation[]
  officialLetters OfficialLetter[]

  @@index([teamLeaderId])
  @@map("candidates")
}

model RoundEvaluation {
  id              String                @id @default(uuid())
  candidateId     String
  candidate       Candidate             @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  round           InterviewRoundType
  result          RoundEvaluationResult
  interviewerName String
  rating          Float
  feedback        String
  rejectionReason String?
  evaluatedAt     DateTime              @default(now())

  @@map("round_evaluations")
}

model PortalNotification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("GENERAL")
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@map("portal_notifications")
}

enum PunchSource {
  FACIAL_DEVICE
  SITE_VISIT_GPS
  WEB
}

enum PunchDirection {
  IN
  OUT
}

// Tier 1: Raw Physical & GPS Biometric Logs (Strictly Append-Only)
model AttendanceRawLog {
  id             String         @id @default(uuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  source         PunchSource
  direction      PunchDirection
  rawTimestamp   DateTime       @default(now())
  latitude       Float?
  longitude      Float?
  projectId      String?
  deviceIp       String?
  faceConfidence Float?
  status         String         @default("VALIDATED")
  createdAt      DateTime       @default(now())

  @@index([userId, rawTimestamp])
  @@index([source])
  @@map("attendance_raw_logs")
}

// Field Sales Site Visits (<= 300m GPS geofence)
model SiteVisit {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId      String
  projectName    String
  leadId         String?
  checkInTime    DateTime  @default(now())
  checkOutTime   DateTime?
  checkInLat     Float
  checkInLng     Float
  checkOutLat    Float?
  checkOutLng    Float?
  distanceMeters Float?
  notes          String?
  status         String    @default("VALIDATED")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId, checkInTime])
  @@map("site_visits")
}

// Monthly Attendance Regularization Requests
model AttendanceRegularization {
  id             String           @id @default(uuid())
  userId         String
  user           User             @relation("RegularizationApplicant", fields: [userId], references: [id], onDelete: Cascade)
  attendanceDate DateTime         @db.Date
  requestedIn    DateTime?
  requestedOut   DateTime?
  reason         String
  status         ApprovalDecision @default(PENDING)
  reviewedById   String?
  reviewedBy     User?            @relation("RegularizationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt     DateTime?
  remarks        String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([userId])
  @@index([status])
  @@map("attendance_regularizations")
}

// Organizational Designations
model Designation {
  id           String      @id @default(uuid())
  title        String      @unique
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  description  String?
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@map("designations")
}

// Shift & Grace Period Configurations
model ShiftSetting {
  id                 String   @id @default(uuid())
  name               String   @unique
  startTime          String   @default("09:30")
  endTime            String   @default("18:30")
  gracePeriodMinutes Int      @default(15)
  fullDayHours       Float    @default(8.5)
  halfDayHours       Float    @default(4.0)
  isDefault          Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("shift_settings")
}

// ============================================================================
// Payroll Engine & Payslips (DRAFT -> LOCKED -> PAID)
// ============================================================================

enum PayrollRunStatus {
  DRAFT
  LOCKED
  PAID
}

model PayrollRun {
  id                 String           @id @default(uuid())
  month              Int
  year               Int
  status             PayrollRunStatus @default(DRAFT)
  totalEmployees     Int              @default(0)
  totalGross         Float            @default(0)
  totalDeductions    Float            @default(0)
  totalNetPay        Float            @default(0)
  generatedById      String
  lockedById         String?
  lockedAt           DateTime?
  paidById           String?
  paidAt             DateTime?
  isPayslipVisible   Boolean          @default(false)
  payslipsReleasedAt DateTime?
  emailsDispatchedAt DateTime?
  notes              String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  generatedBy User      @relation("PayrollGenerator", fields: [generatedById], references: [id])
  lockedBy    User?     @relation("PayrollLocker", fields: [lockedById], references: [id])
  paidBy      User?     @relation("PayrollPayer", fields: [paidById], references: [id])
  payslips    Payslip[]

  @@unique([month, year])
  @@index([year, month])
  @@map("payroll_runs")
}

model Payslip {
  id                 String    @id @default(uuid())
  payrollRunId       String
  userId             String
  month              Int
  year               Int
  workingDaysInMonth Int
  presentDays        Float     @default(0)
  halfDays           Int       @default(0)
  lopDays            Float     @default(0)
  monthlyGross       Float     @default(0)
  basicPay           Float     @default(0)
  hra                Float     @default(0)
  specialAllowance   Float     @default(0)
  lopDeduction       Float     @default(0)
  professionalTax    Float     @default(0)
  otherDeductions    Float     @default(0)
  bonus              Float     @default(0)
  netPay             Float     @default(0)
  emailSentAt        DateTime?
  emailMessageId     String?
  remarks            String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([payrollRunId, userId])
  @@index([userId, year, month])
  @@map("payslips")
}

// ==========================================
// Official Corporate Letters & Certificates
// ==========================================


enum LetterType {
  OFFER_LETTER
  EXPERIENCE_LETTER
  INTERNSHIP_LETTER
}

enum LetterStatus {
  DRAFT
  ISSUED
  REVOKED
}

model OfficialLetter {

  id              String       @id @default(uuid())
  refNumber       String       @unique
  letterType      LetterType   @default(OFFER_LETTER)
  status          LetterStatus @default(ISSUED)
  recipientName   String
  recipientEmail  String
  recipientPhone  String?
  designation     String
  department      String
  annualGrossCtc  Float?
  monthlyGross    Float?
  joiningDate     DateTime?
  workLocation    String?
  probationMonths Int?
  validUntil      DateTime?
  ceoName         String       @default("Mark Anthony Fegradoe")
  ceoTitle        String       @default("Founder & Chief Executive Officer")
  headOfHrName    String       @default("Shilpa Kumari P")
  headOfHrTitle   String       @default("Head of Finance and Human Resources")
  customNotes     String?
  candidateId     String?
  employeeId      String?
  createdById     String?
  employeeCode    String?
  recipientGender String?
  relievingDate   DateTime?
  emailSentAt     DateTime?
  emailSentTo     String?
  candidateResponse String?
  respondedAt     DateTime?
  responseRemarks String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  candidate Candidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  employee  Employee?  @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  createdBy User?      @relation("LetterCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@map("official_letters")
}

// ==========================================
// Offboarding & 1-Month Notice Period NOC
// ==========================================

enum OffboardingStatus {
  PENDING_APPROVAL
  IN_NOTICE
  COMPLETED
  WITHDRAWN
}

enum NocStatus {
  PENDING
  CLEARED
}

model OffboardingRequest {
  id                  String            @id @default(uuid())
  userId              String
  user                User              @relation("OffboardingUser", fields: [userId], references: [id], onDelete: Cascade)
  employeeId          String
  employee            Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  initiatedById       String?
  initiatedBy         User?             @relation("OffboardingInitiator", fields: [initiatedById], references: [id], onDelete: SetNull)
  offboardingType     String            @default("RESIGNATION")
  status              OffboardingStatus @default(PENDING_APPROVAL)
  resignationDate     DateTime          @default(now())
  lastWorkingDay      DateTime
  lastDayNotifiedAt   DateTime?
  noticePeriodDays    Int               @default(30)
  reason              String
  handoverNotes       String?
  earlyReleaseRemarks String?
  approvedAt          DateTime?
  completedAt         DateTime?
  withdrawnAt         DateTime?

  handoverNocStatus   NocStatus         @default(PENDING)
  handoverClearedBy   String?
  handoverClearedAt   DateTime?
  handoverRemarks     String?

  assetsNocStatus     NocStatus         @default(PENDING)
  assetsClearedBy     String?
  assetsClearedAt     DateTime?
  assetsRemarks       String?

  financeNocStatus    NocStatus         @default(PENDING)
  financeClearedBy    String?
  financeClearedAt    DateTime?
  financeRemarks      String?

  hrNocStatus         NocStatus         @default(PENDING)
  hrClearedBy         String?
  hrClearedAt         DateTime?
  hrRemarks           String?

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([userId, status])
  @@index([status])
  @@map("offboarding_requests")
}
